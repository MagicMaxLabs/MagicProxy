# Binaries — shipped via GitHub Releases, never committed
vendor-bin/*.exe
vendor-bin/sing-box*
vendor-bin/com.magicproxy.host.json
*.exe

# Build outputs
installer/Output/
dist/
MagicProxy-extension-store.zip
MagicProxy-windows-amd64.zip
SHA256SUMS.txt
native-host/bin/

# Private signing key — NEVER commit.
# NOTE: since the Chrome Web Store issued the item's key, extension/manifest.json's
# "key" field is the store's PUBLIC key and is committed on purpose. The keys/
# directory only holds the now-superseded self-generated pair.
keys/

# Node
node_modules/

# OS / editor
.DS_Store
Thumbs.db
*.log

# Scratch
tmp-*/
.dnstest/

# Локальное превью иконки — не для репозитория
preview-icon.html

# Рабочая оснастка — не часть продукта и не публичная документация.
# Файлы остаются на диске, но из репозитория выведены: планы запуска, гайды по
# публикации, состояние сессий, брифы на графику, промо-ассеты для листингов и
# отчёт предпубликационного аудита.
